    ORDER BY
        TotalSalesValue DESC
    LIMIT 5;
    """
    drivers_df = execute_sql_query(drivers_query)
    results_by_dimension[f'Top_5_Driving_{dimension}s'] = drivers_df
    draggers_query = f"""
