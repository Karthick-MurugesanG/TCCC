        SUM(SalesValue) AS TotalSalesValue
    FROM
        {table_name}
    WHERE
        PeriodLabel = '{period_filter}'
    GROUP BY
        {dimension}
    ORDER BY
        TotalSalesValue ASC
    LIMIT 5;
