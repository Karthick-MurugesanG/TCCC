table_name = "table_2e7874f3f6cd4959b6341afcc38ee0e5"
period_filter = "Mar 2026" # Using the period specified in the filters
region_filter = "KwaZulu Natal"
channel_filter = "TEG"
customer_filter = "Superspar Census"

# --- Part 1: Overall Market Performance for South Africa for the specified period ---
# Assuming the entire dataset relates to South Africa, and PeriodLabel "Mar 2026" is the target.
# If 'Mar 2026' data is not available in the table, this will return an empty DataFrame.
overall_market_performance_query = f"""
SELECT
    PeriodLabel,
    SUM(SalesValue) AS TotalSalesValue
FROM
    {table_name}
WHERE
    PeriodLabel = '{period_filter}'
GROUP BY
    PeriodLabel;
"""
overall_market_performance_df = execute_sql_query(overall_market_performance_query)

print(f"Overall Market Performance in South Africa for {period_filter}:")
if not overall_market_performance_df.empty:
    print(overall_market_performance_df)
else:
    print(f"No overall market data found for {period_filter}. The provided sample data is for Jan 2026.")

print("\n" + "="*50 + "\n")

# --- Part 2: Identifying Drivers (Top Contributors) and Draggers (Lowest Contributors) by various dimensions ---
# Note: Without historical data, 'draggers' are interpreted as segments with the lowest sales contribution
# for the specified period, not necessarily declining segments.
dimensions_to_analyze = ['Brand', 'Channel', 'Customer', 'Region']
results_by_dimension = {}

for dimension in dimensions_to_analyze:
    # Top 5 Drivers for the dimension (highest sales value)
    drivers_query = f"""
    SELECT
        {dimension},
        SUM(SalesValue) AS TotalSalesValue
    FROM
        {table_name}
    WHERE
        PeriodLabel = '{period_filter}'
    GROUP BY
        {dimension}
    ORDER BY
        TotalSalesValue DESC
    LIMIT 5;
    """
    drivers_df = execute_sql_query(drivers_query)
    results_by_dimension[f'Top_5_Driving_{dimension}s'] = drivers_df

    # Bottom 5 Draggers for the dimension (lowest sales value)
    draggers_query = f"""
    SELECT
        {dimension},
        SUM(SalesValue) AS TotalSalesValue
    FROM
        {table_name}
    WHERE
        PeriodLabel = '{period_filter}'
    GROUP BY
        {dimension}
    ORDER BY
        TotalSalesValue ASC
    LIMIT 5;
    """
    draggers_df = execute_sql_query(draggers_query)
    results_by_dimension[f'Bottom_5_Dragger_{dimension}s'] = draggers_df

# Print results for drivers and draggers
for key, df in results_by_dimension.items():
    print(f"{key} for {period_filter}:")
    if not df.empty:
        print(df)
    else:
        print(f"No data found for {key} in {period_filter}. This might be due to no data for the specified period.")
    print("\n" + "="*50 + "\n")


# --- Part 3: Performance of the specific segment mentioned in the filters ---
# Filters: period=Mar 2026, channel=TEG, customer=Superspar Census, region=KwaZulu Natal
specific_segment_performance_query = f"""
SELECT
    PeriodLabel,
    Channel,
    Customer,
    Region,
    SUM(SalesValue) AS SpecificSegmentSalesValue
FROM
    {table_name}
WHERE
    PeriodLabel = '{period_filter}' AND
    Channel = '{channel_filter}' AND
    Customer = '{customer_filter}' AND
    Region = '{region_filter}'
GROUP BY
    PeriodLabel, Channel, Customer, Region;
"""
specific_segment_performance_df = execute_sql_query(specific_segment_performance_query)

print(f"Performance for the specific segment (Channel='{channel_filter}', Customer='{customer_filter}', Region='{region_filter}') for {period_filter}:")
if not specific_segment_performance_df.empty:
    print(specific_segment_performance_df)
else:
    print(f"No data found for the specified segment in {period_filter}. This might be due to no data for the specified period or specific combination of filters.")
