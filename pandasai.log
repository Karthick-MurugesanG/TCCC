    total_sales_volume = df_performance.iloc[0]['TotalSalesVolume']
    avg_distribution = df_performance.iloc[0]['AverageDistribution']
    avg_price = df_performance.iloc[0]['AveragePrice']
    performance_summary += f"""COCA-COLA's performance in KwaZulu Natal, South Africa (March 2026, TEG channel, Superspar Census customer) is as follows:
"""
    performance_summary += f'- Total Sales Value: R{total_sales_value:,.2f}\n'
    performance_summary += f'- Total Sales Volume: {total_sales_volume:,.2f} units\n'
    if avg_distribution is not None:
        performance_summary += f'- Average Distribution: {avg_distribution:,.2f}%\n'
    else:
        performance_summary += '- Average Distribution: Not available\n'
    if avg_price is not None:
        performance_summary += f'- Average Price: R{avg_price:,.2f}\n\n'
    else:
        performance_summary += '- Average Price: Not available\n\n'
    drivers = []
    draggers = []
    if total_sales_value > 0:
        drivers.append('Positive Sales Value and Volume: The brand is generating revenue and selling units, indicating consumer demand and market presence in this segment.')
    else:
        draggers.append('No Sales Recorded: COCA-COLA did not record any sales in this specific segment (Mar 2026, TEG, Superspar Census, KwaZulu Natal). This is a significant dragger, potentially due to lack of product availability, low demand, or issues with distribution/stocking.')
    if avg_distribution is not None:
        if avg_distribution >= 95.0:
            drivers.append(f'Strong Distribution ({avg_distribution:,.2f}%): High product availability ensures that customers can find COCA-COLA products, driving potential sales.')
        elif avg_distribution > 0:
            draggers.append(f'Sub-optimal Distribution ({avg_distribution:,.2f}%): Room for improvement in product availability. Lower distribution can limit sales potential as products may not be reaching all target consumers or stores consistently.')
        else:
            draggers.append('Zero Distribution: Product is not available in stores for this segment, which is a major dragger on sales.')
    else:
        draggers.append('Distribution data is not available: Lack of information on product availability, which can hide potential draggers or drivers.')
    if avg_price is None or avg_price <= 0:
        draggers.append('No average price data or zero price: This could indicate missing data or an unusual pricing scenario that might impact sales analysis.')
    performance_summary += 'Potential Drivers:\n'
    if drivers:
        for driver in drivers:
            performance_summary += f'- {driver}\n'
    else:
        performance_summary += """- No specific drivers identified based on available data and general assumptions.
"""
    performance_summary += '\nPotential Draggers:\n'
    if draggers:
        for dragger in draggers:
            performance_summary += f'- {dragger}\n'
    else:
        performance_summary += """- No specific draggers identified based on available data and general assumptions.
"""
else:
    performance_summary = 'No data available for COCA-COLA under the specified filters (Brand: COCA-COLA, Period: Mar 2026, Channel: TEG, Customer: Superspar Census, Region: KwaZulu Natal). This indicates that COCA-COLA may not be performing (no sales recorded) in this specific segment, or data is missing for these conditions.'
result = {'type': 'string', 'value': performance_summary}
