# TODO: import the required dependencies
import pandas as pd

# Write code here

# Query 1: Overall market performance for the specified filters
sql_overall_performance = """
SELECT
    SUM(SalesValue) AS total_sales_value,
    SUM(SalesVolume) AS total_sales_volume
FROM
    table_eb58edda7db2d8dba92322d8dba92322d9ec9306dc
WHERE
    Country = 'South Africa'
    AND PeriodLabel = 'Mar 2026'
    AND Channel = 'TEG'
    AND Customer = 'Superspar Census'
    AND Region = 'KwaZulu Natal';
"""
overall_performance_df = execute_sql_query(sql_overall_performance)

# Query 2: Brand-level performance to identify drivers and draggers
# This query gets both SalesValue and SalesVolume for each brand, ordered by SalesValue in descending order
sql_brand_performance = """
SELECT
    Brand,
    SUM(SalesValue) AS brand_sales_value,
    SUM(SalesVolume) AS brand_sales_volume
FROM
    table_eb58edda7db2d8dba92322d8dba92322d9ec9306dc
WHERE
    Country = 'South Africa'
    AND PeriodLabel = 'Mar 2026'
    AND Channel = 'TEG'
    AND Customer = 'Superspar Census'
    AND Region = 'KwaZulu Natal'
GROUP BY
    Brand
ORDER BY
    brand_sales_value DESC;
"""
brand_performance_df = execute_sql_query(sql_brand_performance)

# Initialize result string
result_string = ""

# Check if any overall performance data was found
if overall_performance_df.empty or overall_performance_df.iloc[0]['total_sales_value'] is None:
    result_string = "No data found for the specified filters (Mar 2026, South Africa, TEG, Superspar Census, KwaZulu Natal)."
else:
    total_sales_value = overall_performance_df.iloc[0]['total_sales_value']
    total_sales_volume = overall_performance_df.iloc[0]['total_sales_volume']

    result_string += f"In Mar 2026, for TEG channel at Superspar Census in KwaZulu Natal, South Africa:\n"
    result_string += f"The market showed a total sales value of {total_sales_value:,.2f} and a total sales volume of {total_sales_volume:,.2f}.\n\n"

    # Check if brand-level performance data is available to identify drivers and draggers
    if brand_performance_df.empty:
        result_string += "No brand-specific performance data available for this period and filters to identify drivers and draggers."
    else:
        # Identify drivers (top brands by sales value)
        top_brands = brand_performance_df.head(3) # Get top 3 brands
        drivers_list = []
        for _, row in top_brands.iterrows():
            drivers_list.append(f"{row['Brand']} (Value: {row['brand_sales_value']:,.2f}, Volume: {row['brand_sales_volume']:,.2f})")
        
        if drivers_list:
            result_string += f"Key performance drivers (top brands by sales value):\n- " + "\n- ".join(drivers_list) + "\n\n"
        else:
            result_string += "No specific brands identified as drivers.\n\n"

        # Identify draggers (bottom brands by sales value)
        # We identify draggers only if there are enough distinct brands to make a meaningful distinction
        if len(brand_performance_df) > 3: 
            # Get bottom 3 brands and sort them by value ascending for presentation clarity
            bottom_brands = brand_performance_df.tail(3).sort_values(by='brand_sales_value')
            draggers_list = []
            for _, row in bottom_brands.iterrows():
                draggers_list.append(f"{row['Brand']} (Value: {row['brand_sales_value']:,.2f}, Volume: {row['brand_sales_volume']:,.2f})")
            
            if draggers_list:
                result_string += f"Potential performance draggers (lowest brands by sales value):\n- " + "\n- ".join(draggers_list)
            else:
                result_string += "No specific brands identified as draggers."
        elif len(brand_performance_df) > 0:
            result_string += "Fewer than 4 distinct brands identified, so a clear distinction between drivers and draggers is not meaningfully separable in this specific context."
        else:
            result_string += "No specific brands identified as draggers."

# Declare result var: 
result = { "type": "string", "value": result_string }
