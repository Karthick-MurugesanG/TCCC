    result_value_parts = []
    result_value_parts.append(f"Market Performance in South Africa (Mar 2026, Channel: TEG, Customer: Superspar Census, Region: KwaZulu Natal):")
    result_value_parts.append(f"Overall Total Sales Value: {total_sales_value:.2f}")
    result_value_parts.append(f"Overall Total Sales Volume: {total_sales_volume:.2f}\n")

    # Identify drivers (top brands by SalesValue)
    top_drivers = df_performance.head(3)
    if not top_drivers.empty:
        result_value_parts.append("Top performing brands (Drivers) by SalesValue:")
        for _, row in top_drivers.iterrows():
            result_value_parts.append(f"- {row['Brand']}: SalesValue={row['SalesValue']:.2f}, SalesVolume={row['SalesVolume']:.2f}, Avg. Price={row['AveragePrice']:.2f}, Avg. Distribution={row['AverageDistribution']:.2f}%")
        result_value_parts.append("") # Add a blank line for separation

    # Identify draggers (bottom brands by SalesValue) only if there are clearly distinct draggers
    # (i.e., more than 3 brands total, so that the bottom 3 are not overlapping significantly with the top 3).
    if num_brands > 3:
        bottom_draggers = df_performance.tail(3)
        result_value_parts.append("Brands with lower performance (Draggers) by SalesValue:")
        for _, row in bottom_draggers.iterrows():
            result_value_parts.append(f"- {row['Brand']}: SalesValue={row['SalesValue']:.2f}, SalesVolume={row['SalesVolume']:.2f}, Avg. Price={row['AveragePrice']:.2f}, Avg. Distribution={row['AverageDistribution']:.2f}%")
    elif num_brands > 0 and num_brands <= 3:
         result_value_parts.append("There are 3 or fewer brands in this segment, so all are listed under top performers, and no distinct 'draggers' are identified separately.")

    result_value = "\n".join(result_value_parts)
    result = {'type': 'string', 'value': result_value}
